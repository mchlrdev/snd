{
  "name": "snd",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch --env-file-if-exists=.env src/index.ts\" \"npm --prefix web run dev\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc && npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
