# Pflicht in Produktion. Lokal ohne diese Zeile: Passwort „snd“.
SND_PASSWORD=

# Optional. Sonst schreibt snd eine Datei data/secret (mit der Datenbank sichern).
# SND_SECRET=

# Optional, nur Erststart. Sonst legt die UI unter Einstellungen ein Token an.
# SND_MCP_TOKEN=

# Öffentliche Basis-URL dieser Instanz (ohne Slash am Ende). Für Snippets und Cookies.
# SND_PUBLIC_URL=https://snd.example.com

# SND_DATA_DIR=./data
# SND_PORT=3000
# SND_HOST=0.0.0.0
# Hinter einem Reverse-Proxy (Caddy) die Client-IP aus X-Forwarded-For lesen:
# SND_TRUST_PROXY=1
# Zeitzone für Datum und Uhrzeit in den Benachrichtigungs-Mails (Standard: Europe/Berlin).
# SND_TIMEZONE=Europe/Berlin
