# Required in production. Locally without this line the password is "snd".
SND_PASSWORD=

# Optional. Otherwise snd writes a file data/secret (back it up with the database).
# SND_SECRET=

# Optional, first start only. Otherwise the UI creates a token under Settings.
# SND_MCP_TOKEN=

# Public base URL of this instance (without trailing slash). Used for snippets and cookies.
# SND_PUBLIC_URL=https://snd.example.com

# SND_DATA_DIR=./data
# SND_PORT=3000
# SND_HOST=0.0.0.0
# Behind a reverse proxy (Caddy), read the client IP from X-Forwarded-For:
# SND_TRUST_PROXY=1
# Time zone for date and time in notification mails (default: Europe/Berlin).
# SND_TIMEZONE=Europe/Berlin
